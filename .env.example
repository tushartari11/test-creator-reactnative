# ===========================================
# Test Creator — Production Environment File
# ===========================================
# Copy this to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.

# --- Database ---
DB_NAME=testcreator
DB_USERNAME=testcreator_user
DB_PASSWORD=CHANGE_ME_strong_random_password

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_another_strong_password

# --- JWT ---
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_string

# --- Application ---
BASE_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# --- Guest tokens ---
GUEST_TOKEN_EXPIRY_HOURS=24

# --- Proctoring ---
PROCTORING_MAX_VIOLATIONS=10
PROCTORING_MAX_CRITICAL=3
PROCTORING_MAX_TAB_SWITCHES=5

# --- Monitoring (Grafana) ---
GF_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
