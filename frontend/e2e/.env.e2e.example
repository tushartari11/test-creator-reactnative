# Copy to .env.e2e and adjust as needed. Never commit .env.e2e.
#
# Where the frontend is reachable during tests.
#   - Phase 1 (static serve of dist/):   http://localhost:4173
#   - Phase 2+ (Spring Boot serves dist): http://localhost:8080
E2E_BASE_URL=http://localhost:4173

# Backend test-support API (Phase 2 — not used by smoke tests).
E2E_BACKEND_URL=http://localhost:8080
E2E_TEST_SUPPORT_PATH=/api/test-support
