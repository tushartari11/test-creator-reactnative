{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:staging": "EXPO_PUBLIC_APP_ENV=staging EXPO_PUBLIC_API_URL=https://staging.testcreator.example.com/api expo start",
    "start:prod": "EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_API_URL=http://167.71.60.139:8080/api expo start",
    "android": "expo start --android",
    "android:staging": "EXPO_PUBLIC_APP_ENV=staging EXPO_PUBLIC_API_URL=https://staging.testcreator.example.com/api expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:staging": "EXPO_PUBLIC_APP_ENV=staging EXPO_PUBLIC_API_URL=https://staging.testcreator.example.com/api expo start --web",
    "web:prod": "EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_API_URL=http://167.71.60.139:8080/api expo start --web",
    "export:web": "expo export --platform web",
    "bdd:gen": "bddgen --config=e2e/playwright.config.ts",
    "test:e2e": "npm run bdd:gen && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:dev": "npm run bdd:gen && playwright test --config=e2e/playwright.config.ts --headed --workers=1",
    "test:e2e:ui": "npm run bdd:gen && playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:debug": "npm run bdd:gen && PWDEBUG=1 playwright test --config=e2e/playwright.config.ts --headed --workers=1",
    "test:e2e:ci": "npm run bdd:gen && CI=1 playwright test --config=e2e/playwright.config.ts",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.28",
    "expo": "~55.0.6",
    "expo-constants": "~55.0.7",
    "expo-font": "~55.0.4",
    "expo-linking": "~55.0.7",
    "expo-router": "~55.0.5",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-web-browser": "~55.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.7",
    "@types/react": "~19.2.2",
    "dotenv": "^16.4.7",
    "playwright-bdd": "^8.2.0",
    "serve": "^14.2.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
